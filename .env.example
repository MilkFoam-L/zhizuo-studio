# Local app binds to loopback by default. Never commit real secrets.
HOST=127.0.0.1
PORT=4317
DATA_DIR=.data
# Optional PostgreSQL; otherwise PGlite persists to DATA_DIR/db
# DATABASE_URL=postgres://user:password@localhost:5432/zhizuo
# Required for hosted mode. Local mode creates a private encryption key in DATA_DIR.
# ENCRYPTION_KEY=64_hex_characters
# APP_PASSWORD=choose-a-strong-password-before-binding-publicly
# APP_ORIGIN=https://your-domain.example

# Access modes: local (default), shared (APP_PASSWORD), or accounts.
# AUTH_MODE=accounts
# First accounts-mode startup only; later starts never reset an existing password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-characters
# ADMIN_NAME=管理员

STORAGE_BACKEND=local
# S3-compatible private bucket; HTTPS endpoint, API proxies protected reads/writes.
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://your-s3-endpoint.example
# S3_REGION=auto
# S3_BUCKET=your-private-bucket
# S3_ACCESS_KEY_ID=replace-locally
# S3_SECRET_ACCESS_KEY=replace-locally
# S3_PREFIX=zhizuo/assets
# S3_FORCE_PATH_STYLE=true
# Per workspace, counted using Asia/Shanghai dates.
MAX_DAILY_TASKS=100

# inline: API runs the queue (PGlite/local default).
# external: API only enqueues; start one or more npm run start:worker processes.
# External mode requires the same PostgreSQL, ENCRYPTION_KEY, AUTH_MODE and storage on all processes.
WORKER_MODE=inline
